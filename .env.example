# Easy Web Scraper - Environment Variables Template
# Copy this file to .env.local to override settings locally (git-ignored)

# Payment Mode: 'test' | 'live'
VITE_PAYMENT_MODE=test

# Dodo Payments Checkout URLs (Test Mode defaults or Live Mode overrides)
VITE_CHECKOUT_MONTHLY_URL=https://test.checkout.dodopayments.com/buy/pdt_0Nr8dOIRnaz5hwzASF9YS?quantity=1&redirect_url=https://easyscraper.pages.dev/payment/success
VITE_CHECKOUT_YEARLY_URL=https://test.checkout.dodopayments.com/buy/pdt_0NslzdbCGz7CGbGj83Akp?quantity=1&redirect_url=https://easyscraper.pages.dev/payment/success
VITE_CHECKOUT_LIFETIME_URL=https://test.checkout.dodopayments.com/buy/pdt_0Nr8cSXRWviaMfq4VAT7o?quantity=1&redirect_url=https://easyscraper.pages.dev/payment/success

# Chrome Web Store Extension Install URL
VITE_CHROME_STORE_URL=https://chromewebstore.google.com/detail/easy-web-scraper-%E6%99%BA%E8%83%BD%E7%BD%91%E9%A1%B5%E6%95%B0%E6%8D%AE%E9%87%87%E9%9B%86/hgbfnbcinkkopmgjckiabcofoohabhbn

# Microsoft Edge Add-ons Extension Install URL
VITE_EDGE_STORE_URL=https://microsoftedge.microsoft.com/addons/detail/easy-web-scraper/hgbfnbcinkkopmgjckiabcofoohabhbn

# Server-side Secret API Key for License Device Querying (Local .env.local only)
DODO_PAYMENTS_API_KEY=
